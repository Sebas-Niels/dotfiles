{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
    "logo": {
        "source": "PrismLinux",
        "padding": {
            "top": 4,
            "left": 5,
            "right": 5
        }
    },
    "display": {
        "bar": {
            "char": {
                "total": "─"
            },
            "color": {
                "border": "38;2;80;224;224",
                "total": "38;2;80;224;224"
            },
            "width": 10
        },
        "percent": {
            "type": 3,
            "ndigits": 2
        },
        "key": {
            "width": 16
        },
        "separator": "",
        "color": {
            "title": "38;2;199;125;255",
            "output": "38;2;80;224;224"
        }
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "key": "╭─System─────┬───────────────────────────────────────────────────╮",
            "keyColor": "38;2;199;125;255"
        },
        {
            "type": "host",
            "key": "├╴󰌢 PC       │",
            "keyColor": "38;2;199;125;255",
            "format": "{name<16}({version<6})                          {#38;2;199;125;255}│{#}"
        },
        {
            "type": "os",
            "key": "├╴\uf17c OS       │",
            "keyColor": "38;2;199;125;255",
            "format": "{name<6}{version<6}({codename<5}) {arch<6}                        {#38;2;199;125;255}│{#}"
        },
        {
            "type": "wm",
            "key": "├╴\uf2d0 WM       │",
            "keyColor": "38;2;199;125;255",
            "format": "{pretty-name<5}{version<6}({protocol-name<7})                              {#38;2;199;125;255}│{#}"
        },
        {
            "type": "lm",
            "key": "├╴󰧨 LM       │",
            "keyColor": "38;2;199;125;255",
            "format": "{pretty-name<20}{version<30}{#38;2;199;125;255}│{#}"
        },
        {
            "type": "kernel",
            "key": "├╴\uf013 Kernel   │",
            "keyColor": "38;2;199;125;255",
            "format": "{sysname<6}{release<44}{#38;2;199;125;255}│{#}"
        },
        {
            "type": "bios",
            "key": "├╴\uf0ad BIOS     │",
            "keyColor": "38;2;199;125;255",
            "format": "{version<5}({release<4})                                       {#38;2;199;125;255}│{#}"
        },
        {
            "type": "packages",
            "key": "├╴󰏖 Packages │",
            "keyColor": "38;2;199;125;255",
            "format": "{nix-system<5}(nix-system), {nix-user<4}(nix-user)                 {#38;2;199;125;255}│{#}"
        },
        {
            "type": "font",
            "key": "├╴\uf031 Font     │",
            "keyColor": "38;2;199;125;255",
            "format": "{combined<50}{#38;2;199;125;255}│{#}"
        },
        {
            "type": "custom",
            "key": "╰────────────┴───────────────────────────────────────────────────╯",
            "keyColor": "38;2;199;125;255"
        },
        {
            "type": "custom",
            "key": "╭─Terminal───┬───────────────────────────────────────────────────╮",
            "keyColor": "38;2;199;125;255"
        },
        {
            "type": "shell",
            "key": "├╴\uf489 Shell    │",
            "keyColor": "38;2;199;125;255",
            "format": "{pretty-name<4}{version<46}{#38;2;199;125;255}│{#}"
        },
        {
            "type": "terminal",
            "key": "├╴\uf120 Terminal │",
            "keyColor": "38;2;199;125;255",
            "format": "{pretty-name<6}{version<44}{#38;2;199;125;255}│{#}"
        },
        {
            "type": "terminalfont",
            "key": "├╴\uf031 Font     │",
            "keyColor": "38;2;199;125;255",
            "format": "{combined<50}{#38;2;199;125;255}│{#}"
        },
        {
            "type": "custom",
            "key": "╰────────────┴───────────────────────────────────────────────────╯",
            "keyColor": "38;2;199;125;255"
        },
        {
            "type": "custom",
            "key": "╭─Hardware───┬───────────────────────────────────────────────────╮",
            "keyColor": "38;2;199;125;255"
        },
        {
            "type": "display",
            "key": "├╴󰍹 Display  │",
            "keyColor": "38;2;199;125;255",
            "format": "{width<4}×{height<4}, {refresh-rate>3}Hz [{type<8}]                       {#38;2;199;125;255}│{#}"
        },
        {
            "type": "cpu",
            "key": "├╴\uf2db CPU      │",
            "keyColor": "38;2;199;125;255",
            "format": "{name<28}[{cores-physical<2} cores]            {#38;2;199;125;255}│{#}"
        },
        {
            "type": "gpu",
            "key": "├╴󰾲 GPU      │",
            "keyColor": "38;2;199;125;255",
            "format": "{vendor<7}{name<23}[{type<8}]          {#38;2;199;125;255}│{#}"
        },
        {
            "type": "memory",
            "key": "├╴󰍛 RAM      │",
            "keyColor": "38;2;199;125;255",
            "format": "{percentage-bar} {used<9}/ {total<10}({percentage<6})      {#38;2;199;125;255}│{#}"
        },
        {
            "type": "disk",
            "key": "├╴\uf0a0 Disk     │",
            "keyColor": "38;2;199;125;255",
            "format": "{size-percentage-bar} {size-used>10} / {size-total<9}({size-percentage>6})     {#38;2;199;125;255}│{#}",
            "showExternal": true,
            "showHidden": true,
            "showSubvolumes": false,
            "showReadOnly": false,
            "showUnknown": true
        },
        {
            "type": "custom",
            "key": "╰────────────┴───────────────────────────────────────────────────╯",
            "keyColor": "38;2;199;125;255"
        },
        {
            "type": "custom",
            "key": "╭─Uptime─────┬",
            "keyColor": "38;2;199;125;255",
            "format": "{#90}◆ {#97}◆ {#94}◆ {#95}◆ {#96}◆ {#93}◆ {#92}◆ {#91}◆ {#38;2;199;125;255}──────────────────────────────────╮{#}"
        },
        {
            "type": "uptime",
            "key": "├╴\uf017 Uptime   │",
            "keyColor": "38;2;199;125;255",
            "format": "{formatted<50}{#38;2;199;125;255}│{#}"
        },
        {
            "type": "command",
            "key": "├╴󱦟 OS Age   │",
            "keyColor": "38;2;199;125;255",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); days_difference=$(( (current - birth_install) / 86400 )); printf '%-50s\\033[38;2;199;125;255m│\\033[0m' \"$days_difference days\""
        },
        {
            "type": "custom",
            "key": "╰────────────┴───────────────────────────────────────────────────╯",
            "keyColor": "38;2;199;125;255"
        }
    ]
}